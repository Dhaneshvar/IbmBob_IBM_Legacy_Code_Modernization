       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYROLL.
       AUTHOR. LEGACY-SYSTEMS-TEAM.
       DATE-WRITTEN. 2005-03-15.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EMPLOYEE-FILE  ASSIGN TO "HLQ.PAYROLL.INPUT"
               ORGANIZATION IS SEQUENTIAL.
           SELECT PAYROLL-OUTPUT ASSIGN TO "HLQ.PAYROLL.OUTPUT"
               ORGANIZATION IS SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD  EMPLOYEE-FILE.
       01  EMP-RECORD.
           05  EMP-ID          PIC 9(7).
           05  EMP-NAME        PIC X(30).
           05  EMP-DEPT        PIC X(4).
           05  EMP-HOURLY-RATE PIC S9(5)V99 COMP-3.
           05  EMP-HOURS       PIC S9(3)V9  COMP-3.
           05  EMP-PAY-TYPE    PIC X.
               88  HOURLY-EMPLOYEE     VALUE "H".
               88  SALARIED-EMPLOYEE   VALUE "S".
               88  CONTRACT-EMPLOYEE   VALUE "C".
       FD  PAYROLL-OUTPUT.
       01  PAY-RECORD          PIC X(132).
       WORKING-STORAGE SECTION.
       01  WS-EOF-FLAG         PIC X VALUE "N".
           88  WS-END-OF-FILE      VALUE "Y".
       01  WS-GROSS-PAY        PIC S9(7)V99 COMP-3 VALUE 0.
       01  WS-TAX-AMOUNT       PIC S9(7)V99 COMP-3 VALUE 0.
       01  WS-NET-PAY          PIC S9(7)V99 COMP-3 VALUE 0.
       01  WS-OVERTIME-HOURS   PIC S9(3)V9  COMP-3 VALUE 0.
       01  WS-OVERTIME-PAY     PIC S9(7)V99 COMP-3 VALUE 0.
       01  WS-TAX-RATE         PIC S9V99 COMP-3 VALUE 0.22.
       01  WS-OVERTIME-RATE    PIC S9V9 COMP-3 VALUE 1.5.
       01  WS-STD-HOURS        PIC S9(3)V9 COMP-3 VALUE 40.0.
       01  WS-RECORDS-READ     PIC 9(6) COMP VALUE 0.
       01  WS-RECORDS-WRITTEN  PIC 9(6) COMP VALUE 0.
       01  WS-TOTAL-GROSS      PIC S9(9)V99 COMP-3 VALUE 0.
       01  WS-TOTAL-NET        PIC S9(9)V99 COMP-3 VALUE 0.
       01  WS-PRINT-LINE       PIC X(132).
       01  WS-STATUS           PIC X(2).
       01  WS-ERR-MSG          PIC X(80).
       PROCEDURE DIVISION.
       MAIN.
           OPEN INPUT  EMPLOYEE-FILE.
           OPEN OUTPUT PAYROLL-OUTPUT.
           PERFORM READ-NEXT-EMPLOYEE.
           PERFORM PROCESS-EMPLOYEES UNTIL WS-END-OF-FILE.
           PERFORM WRITE-SUMMARY.
           CLOSE EMPLOYEE-FILE.
           CLOSE PAYROLL-OUTPUT.
           STOP RUN.
       READ-NEXT-EMPLOYEE.
           READ EMPLOYEE-FILE
               AT END MOVE "Y" TO WS-EOF-FLAG
           END-READ.
       PROCESS-EMPLOYEES.
           ADD 1 TO WS-RECORDS-READ.
           MOVE 0 TO WS-GROSS-PAY WS-TAX-AMOUNT WS-NET-PAY.
           EVALUATE TRUE
               WHEN HOURLY-EMPLOYEE
                   PERFORM CALC-HOURLY-PAY
               WHEN SALARIED-EMPLOYEE
                   PERFORM CALC-SALARY-PAY
               WHEN CONTRACT-EMPLOYEE
                   PERFORM CALC-CONTRACT-PAY
               WHEN OTHER
                   MOVE "UNKNOWN PAY TYPE" TO WS-ERR-MSG
                   DISPLAY WS-ERR-MSG
           END-EVALUATE.
           PERFORM CALC-TAX.
           PERFORM WRITE-PAY-RECORD.
           ADD WS-GROSS-PAY TO WS-TOTAL-GROSS.
           ADD WS-NET-PAY   TO WS-TOTAL-NET.
           PERFORM READ-NEXT-EMPLOYEE.
       CALC-HOURLY-PAY.
           IF EMP-HOURS > WS-STD-HOURS
               COMPUTE WS-OVERTIME-HOURS = EMP-HOURS - WS-STD-HOURS
               COMPUTE WS-OVERTIME-PAY =
                   WS-OVERTIME-HOURS * EMP-HOURLY-RATE * WS-OVERTIME-RATE
               COMPUTE WS-GROSS-PAY =
                   WS-STD-HOURS * EMP-HOURLY-RATE + WS-OVERTIME-PAY
           ELSE
               COMPUTE WS-GROSS-PAY = EMP-HOURS * EMP-HOURLY-RATE
           END-IF.
       CALC-SALARY-PAY.
           COMPUTE WS-GROSS-PAY = EMP-HOURLY-RATE * WS-STD-HOURS.
       CALC-CONTRACT-PAY.
           COMPUTE WS-GROSS-PAY = EMP-HOURLY-RATE.
       CALC-TAX.
           IF WS-GROSS-PAY > 5000.00
               COMPUTE WS-TAX-RATE = 0.28
           ELSE IF WS-GROSS-PAY > 2000.00
               COMPUTE WS-TAX-RATE = 0.22
           ELSE
               COMPUTE WS-TAX-RATE = 0.15
           END-IF.
           COMPUTE WS-TAX-AMOUNT = WS-GROSS-PAY * WS-TAX-RATE.
           COMPUTE WS-NET-PAY = WS-GROSS-PAY - WS-TAX-AMOUNT.
       WRITE-PAY-RECORD.
           ADD 1 TO WS-RECORDS-WRITTEN.
           MOVE SPACES TO WS-PRINT-LINE.
           STRING EMP-ID DELIMITED SIZE
                  " " DELIMITED SIZE
                  EMP-NAME DELIMITED SIZE
                  " GROSS=" DELIMITED SIZE
                  WS-GROSS-PAY DELIMITED SIZE
                  " NET=" DELIMITED SIZE
                  WS-NET-PAY DELIMITED SIZE
               INTO WS-PRINT-LINE.
           WRITE PAY-RECORD FROM WS-PRINT-LINE.
       WRITE-SUMMARY.
           DISPLAY "TOTAL RECORDS PROCESSED: " WS-RECORDS-READ.
           DISPLAY "TOTAL GROSS PAYROLL    : " WS-TOTAL-GROSS.
           DISPLAY "TOTAL NET  PAYROLL     : " WS-TOTAL-NET.
